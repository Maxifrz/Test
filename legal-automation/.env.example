# =============================================================================
# Legal Automation Platform — Environment Variables
# Copy this file to .env and fill in all values before starting the stack.
# Variables without a default WILL cause the app to fail on startup if unset.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://legalapp:CHANGE_ME_DB_PASSWORD@postgres:5432/legaldb
DATABASE_URL_SYNC=postgresql+psycopg2://legalapp:CHANGE_ME_DB_PASSWORD@postgres:5432/legaldb
POSTGRES_USER=legalapp
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=legaldb

# --- Redis ---
# Muss zum Passwort des redis-Containers passen (docker-compose: --requirepass).
# setup.sh ersetzt "changeme_redis" überall durch ein generiertes Passwort.
REDIS_PASSWORD=changeme_redis
REDIS_URL=redis://:changeme_redis@redis:6379/0

# --- Security (NO DEFAULTS — app will not start if these are missing) ---
# Generate with: openssl rand -hex 32
SECRET_KEY=

# RSA key pair for JWT RS256. Generate with:
#   openssl genrsa -out private.pem 4096
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key

# Fernet key for PII encryption. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Multiple keys supported (comma-separated, first = current):
ENCRYPTION_KEYS=

# --- Application ---
APP_NAME=Legal Automation Platform
ENVIRONMENT=production
# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Bundesland für Feiertagsberechnung (BY, NW, BW, BE, BB, HB, HH, HE, MV, NI, RP, SL, SN, ST, SH, TH)
BUNDESLAND=BY

# --- Email (IMAP/SMTP) ---
# Configure per account in admin UI; these are defaults for the first account
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=true
IMAP_USERNAME=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Kanzlei
SMTP_FROM_EMAIL=

# --- File Storage ---
STORAGE_ROOT=/storage

# --- Celery ---
CELERY_BROKER_URL=redis://:changeme_redis@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme_redis@redis:6379/2

# --- Transcription ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Set to true if pyannote.audio is available (requires ~1GB extra RAM)
DIARIZATION_ENABLED=true

# --- Session ---
# Minutes of inactivity before auto-logout
SESSION_TIMEOUT_MINUTES=30
# Max failed login attempts before account lockout
MAX_FAILED_LOGINS=5
# Minutes to lock account after too many failures
LOCKOUT_MINUTES=30

# --- DSGVO / Retention ---
# Default matter retention in years (BRAO §50)
DEFAULT_MATTER_RETENTION_YEARS=10
# Email for DSGVO-related admin notifications
DSGVO_CONTACT_EMAIL=

# --- KI-Rechtsrecherche (V3.0, optional) ---
# Erfordert: docker compose --profile ki up  + pgvector-fähiges Postgres-Image
# (pgvector/pgvector:pg16) + Modelle via `ollama pull`.
KI_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
KI_LLM_MODEL=phi3:mini
KI_EMBED_MODEL=nomic-embed-text
KI_EMBED_DIM=768
